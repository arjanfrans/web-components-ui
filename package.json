{
  "name": "@arjanfrans/web-components-ui",
  "version": "1.4.1",
  "private": false,
  "sideEffects": true,
  "description": "Web Components only UI library",
  "main": "dist/lib/main.mjs",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/lib/main.mjs"
    }
  },
  "scripts": {
    "start": "vite --host --port 3000",
    "build:static": "tsc && TARGET=static vite build",
    "build": "tsc && vite build",
    "cs": "af-cs --env browser src",
    "cs:check": "af-cs --check --env browser src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjanfrans/web-components-ui.git"
  },
  "keywords": [
    "web components",
    "ui library"
  ],
  "author": "Arjan Frans",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arjanfrans/web-components-ui/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/arjanfrans/web-components-ui#readme",
  "devDependencies": {
    "@arjanfrans/af-codestyle": "^0.0.6",
    "@types/node": "^20.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-checker": "^0.6.2",
    "vite-plugin-dts": "^4.0.2"
  }
}
